# =========================================================
# Employee Relations (VOS) Environment Configuration
# =========================================================

# --- 1. Directus CMS API (Subsystems, modules, employee data) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8055
DIRECTUS_STATIC_TOKEN=your_directus_static_token_here

# --- 2. Spring Boot Core API (Authentication & RBAC) ---
SPRING_API_BASE_URL=http://localhost:8080

# --- 3. Authentication & Security Toggles ---
# Set to true to bypass authentication during UI development/testing
NEXT_PUBLIC_AUTH_DISABLED=false

# Cookie security settings (true for HTTPS, false for local HTTP dev)
COOKIE_SECURE=false

# --- 4. Subscription & Module Lock Mode ---
# Options: "disabled" | "hide" | "enable"
NEXT_PUBLIC_LOCKED_MODULE_MODE=enable

# --- 5. Cron Secret (for scheduled recurring tasks) ---
CRON_SECRET=

